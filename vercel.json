{
  "crons": [{ "path": "/api/integrations/zex/recover", "schedule": "0 2 * * *" }],
  "functions": { "api/integrations/zex/recover.js": { "maxDuration": 60 }, "api/integrations/zex/webhook.js": { "maxDuration": 60 } },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/.*", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
