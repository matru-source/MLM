# Server-only values. Never prefix secrets with VITE_.
DATABASE_URL=
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Exact browser origin, without a trailing path. Use your HTTPS origin in production.
PORTAL_ORIGIN=http://localhost:5173
# Set the deduction rate approved for your payout policy, as a decimal (0 to 1).
PAYOUT_TDS_RATE=
ZEX_PARTNER_API_KEY=
MLM_WEBHOOK_SECRET=
MLM_PARTNER_ID=cybernetworking
ZEX_API_BASE_URL=https://api.zex4u.com

# Must be confirmed with ZEX; checkout and activation fail closed if unset.
ZEX_PURCHASE_URL=
ZEX_ACTIVATION_PRODUCT_CODE=
# Confirm current INR prices with ZEX; amounts are in paise.
ZEX_JOINING_PRICE_PAISE=
ZEX_RENEWAL_PRICE_PAISE=
# Approved ten commission amounts in paise, comma-separated; total must not exceed verified charge.
ZEX_COMMISSION_RATES_PAISE=
ZEX_COMMISSION_POLICY_VERSION=
ZEX_RESERVE_MEMBER_ID=
# Secret for the scheduled recovery endpoint; at least 32 random characters.
CRON_SECRET=
# Optional operator alert webhook. Configure an HTTPS endpoint that accepts JSON.
ZEX_ALERT_WEBHOOK_URL=
# Alternatively, send operational alerts to an email address using Brevo.
ZEX_ALERT_EMAIL=
